DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carroquesi
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
ALLOWED_ORIGINS=["${FRONTEND_URL}"]
FRONTEND_URL=${FRONTEND_URL}

# GCS bucket for receipt images; leave empty/unset to disable receipt storage
# RECEIPT_STORAGE_BUCKET=your-app.firebasestorage.app

# Shared secret for POST /internal/reports/monthly (X-Trigger-Token); unset = off
# REPORT_TRIGGER_TOKEN=
# Zone for owners whose browser never declared one
# REPORT_DEFAULT_TIMEZONE=Europe/Madrid

# local dev only — skips Firebase token validation when X-Dev-User-Id header is present
# NEVER enable in production
# DEV_AUTH_BYPASS=true
